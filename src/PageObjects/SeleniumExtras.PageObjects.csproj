<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>SeleniumExtras.PageObjects</AssemblyName>
    <RootNamespace>SeleniumExtras</RootNamespace>
    <AssemblyVersion>4.48.0.0</AssemblyVersion>
    <FileVersion>4.48.0.0</FileVersion>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <Version>4.48.0</Version>
    <PackageId>DotNetSeleniumExtras.PageObjects.Core</PackageId>
    <Authors>Dreamescaper</Authors>
    <Description>Fork of DotNetSeleniumExtras with enabled dotnet core support and other features</Description>
    <Copyright>Copyright 2018, Software Freedom Conservancy</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/Dreamescaper/DotNetSeleniumExtras/</PackageProjectUrl>
    <PackageReleaseNotes>https://raw.githubusercontent.com/Dreamescaper/DotNetSeleniumExtras/master/CHANGELOG</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Selenium.WebDriver" Version="4.48.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
